{
  "id": null,
  "uid": "model-performance-drift",
  "title": "Model Performance & Drift",
  "tags": ["bike-sharing", "ml", "drift"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RMSE",
      "description": "Lower values indicate better regression accuracy.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "model_rmse_score", "legendFormat": "RMSE", "instant": false, "range": true, "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "MAE",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "model_mae_score", "legendFormat": "MAE", "instant": false, "range": true, "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "R² score",
      "description": "R-squared may be negative when the model performs worse than a constant baseline.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "model_r2_score", "legendFormat": "R²", "instant": false, "range": true, "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "MAPE (%)",
      "description": "Mean absolute percentage error; zero-valued targets are omitted by Evidently.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "model_mape_score", "legendFormat": "MAPE", "instant": false, "range": true, "refId": "A"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Evidently input drift",
      "description": "The Grafana alert fires when the gauge is greater than zero. Use make fire-alert to demonstrate it.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [{"options": {"0": {"text": "No drift"}, "1": {"text": "Drift detected"}}, "type": "value"}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value"},
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "evidently_data_drift_detected_status", "legendFormat": "Drift status", "instant": true, "range": false, "refId": "A"}]
    }
  ],
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "grafana"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "links": [],
  "templating": {"list": []}
}
